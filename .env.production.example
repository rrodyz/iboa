# ═══════════════════════════════════════════════════════════════════════════════
# A3 ERP — Configuration de production (VPS / CyberPanel)
# ═══════════════════════════════════════════════════════════════════════════════
# 1. Copier ce fichier :  cp .env.production.example .env
# 2. Remplir TOUTES les valeurs entre < >
# 3. Générer une clé :    php artisan key:generate
# 4. NE JAMAIS versionner .env avec de vraies valeurs
# ═══════════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="A3 ERP"
APP_ENV=production
APP_KEY=                              # php artisan key:generate --force
APP_DEBUG=false
APP_URL=https://<votre-domaine.com>

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Ouagadougou
BCRYPT_ROUNDS=12

# ── Base de données MySQL ─────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<nom_base>
DB_USERNAME=<utilisateur_mysql>
DB_PASSWORD=<mot_de_passe_mysql>

# ── Redis (OBLIGATOIRE en production pour perf ×10-50) ───────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_STORE=redis
CACHE_PREFIX=a3erp_

# ── Sessions ──────────────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.<votre-domaine.com>
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ── File d'attente ────────────────────────────────────────────────────────────
QUEUE_CONNECTION=redis
# Worker démarré via Supervisor (voir deploy/supervisor.conf)

# ── Mail SMTP ─────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=<smtp.votre-fournisseur.com>
MAIL_PORT=587
MAIL_USERNAME=<adresse@votre-domaine.com>
MAIL_PASSWORD=<mot_de_passe_smtp>
MAIL_FROM_ADDRESS="noreply@<votre-domaine.com>"
MAIL_FROM_NAME="A3 ERP"

# ── Logs ──────────────────────────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# ── Intégration Orange Money BF ───────────────────────────────────────────────
ORANGE_MONEY_BASE_URL=https://api.orange.com/orange-money-webpay/bf/v1
ORANGE_MONEY_MERCHANT_KEY=<merchant_key>
ORANGE_MONEY_CLIENT_ID=<client_id>
ORANGE_MONEY_CLIENT_SECRET=<client_secret>
ORANGE_MONEY_CALLBACK_URL=${APP_URL}/integrations/webhooks/orange-money

# ── Intégration Twilio SMS ────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=<AC...>
TWILIO_AUTH_TOKEN=<auth_token>
TWILIO_FROM_NUMBER=+226XXXXXXXX

# ── Divers ────────────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
APP_MAINTENANCE_DRIVER=file

# ── Sécurité applicative ───────────────────────────────────────────────────────
# OBLIGATOIRE. audit:business échoue en CRITIQUE si absent/false en production
# (config/security.php) — le contrôle maker-checker (double validation) doit
# rester actif hors environnement de test.
SECURITY_MAKER_CHECKER=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# OBLIGATOIRE si un front/API distinct du domaine principal appelle l'API.
# Origines autorisées, séparées par virgule. Laisser vide si aucun appel
# cross-origin n'est prévu pour le pilote.
CORS_ALLOWED_ORIGINS=https://<votre-domaine.com>

# ── Comptabilisation automatique de la production (SYSCOHADA) ─────────────────
# OPTIONNEL — désactivé par défaut, comme en développement. Quand activé, la
# clôture d'un OF (statut "terminé") génère automatiquement, dans la même
# transaction, DR 6032/CR 321 (sortie matière) et DR 361/CR 736 (production
# stockée) — voir config/production.php et ProductionAccountingService
# (idempotent, testé : tests/Feature/ProductionAccountingTest.php).
# RÉSERVE CONNUE (audit P7.3) : le delta de coût d'une régularisation tardive
# (OF clôturé après expédition partielle/totale du produit fini) n'est PAS
# posté par ce pont — seul l'écart standard OF-terminé est comptabilisé.
# Recommandation pilote : laisser à false tant que le comptable n'a pas
# validé le plan de comptes SYSCOHADA réel d'OA Metal et le contournement
# opérationnel du cas de régularisation tardive.
PRODUCTION_ACCOUNTING_ENABLED=false

# ── Notifications de validation (workflow interne) ─────────────────────────────
# RECOMMANDÉ. Relances email si une validation (commande/OF/achat) dépasse le
# délai configuré (config/validation.php).
VALIDATION_EMAIL_CHANNEL=true
VALIDATION_REMINDER_COMMERCIAL=48
VALIDATION_REMINDER_PRODUCTION=24
VALIDATION_REMINDER_ACHATS=48

# ── Alertes administrateur ──────────────────────────────────────────────────────
# RECOMMANDÉ. Destinataire des alertes système (AdminAlertService) — backups,
# échecs planifiés. Voir aussi BACKUP_NOTIFICATION_EMAIL ci-dessous.
ADMIN_EMAIL=<admin@votre-domaine.com>

# ── Sauvegardes (CDC §14) ────────────────────────────────────────────────────────
# BACKUP_ARCHIVE_PASSWORD : OBLIGATOIRE. Chiffre les archives (AES-256, spatie/
# laravel-backup — config/backup.php). Sans ce mot de passe, les sauvegardes ne
# sont PAS chiffrées.
BACKUP_ARCHIVE_PASSWORD=<mot_de_passe_backup_fort>
# BACKUP_NOTIFICATION_EMAIL : RECOMMANDÉ. Alerté en cas d'échec de backup/
# cleanup ou de backup manquant/trop vieux (backup:monitor, quotidien 07:00).
BACKUP_NOTIFICATION_EMAIL=<ops@votre-domaine.com>

# ── Sauvegarde hors-serveur (seconde destination) ───────────────────────────────
# RECOMMANDÉ — voir deploy/README-BACKUP-REMOTE.md pour la procédure complète.
# Désactivé par défaut : la sauvegarde locale seule reste un point de défaillance
# unique si le serveur est perdu. Réutilise le disque "s3" déjà déclaré dans
# config/filesystems.php (natif Laravel) — aucun disque parallèle créé.
# BACKUP_REMOTE_DISK peut pointer vers tout disque compatible S3 (OVH,
# Scaleway, Backblaze B2, AWS S3...) via AWS_ENDPOINT.
BACKUP_REMOTE_ENABLED=false
BACKUP_REMOTE_DISK=s3
# Identifiants du stockage S3-compatible choisi :
# AWS_ACCESS_KEY_ID=<clé_access>
# AWS_SECRET_ACCESS_KEY=<clé_secrète>
# AWS_DEFAULT_REGION=<region>
# AWS_BUCKET=<bucket>
# AWS_ENDPOINT=<https://endpoint_s3_compatible>
# AWS_USE_PATH_STYLE_ENDPOINT=true

# ── TLS MySQL (OPTIONNEL — uniquement si base managée avec TLS exigé) ──────────
# MYSQL_ATTR_SSL_CA=<chemin_vers_certificat_ca.pem>
